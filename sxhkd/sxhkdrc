XF86AudioRaiseVolume
    amixer sset Master 5%+ unmute

XF86AudioLowerVolume
    amixer sset Master 5%- unmute

XF86AudioMute
    amixer sset Master toggle

XF86MonBrightnessDown
	xbacklight -5

XF86MonBrightnessUp
	xbacklight +5

super + alt + b
	~/.config/rofi/applets/bin/brightness.sh

super + alt + a
	~/.config/rofi/applets/bin/apps.sh

super + shift + b
	~/Software/zen/zen

super + shift + e
    urxvtcd -e yazi

super + shift + n
    urxvtcd -e nvim

super + shift + m
    ~/.config/rofi/applets/bin/mpd.sh

super + shift + z
    zathura

super + shift + c
	urxvtcd -e cava

XF86AudioPlay
	mpc toggle
